  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'To whom it may concern,\n\nI''ve been stuck in this mansion for far too
    long. The doors never seem to lead to the same place, and monsters roam the halls.
    It seems they can''t come in here, so I''ve made this place my base.\n\nI think
    I''ve found a way out. I''ve left my flashlight here in case another person gets
    trapped here, and I''ve left spare batteries in hidden across the mansion. Remember,
    the light stops them.\n\n- M\n\nP.S. The code to open the box is 4920

'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
