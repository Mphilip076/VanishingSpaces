  buttonAudio: {fileID: 1275234947}
  journalText: {fileID: 1402159006}
  journalMessage: 'October 14th,


    I do not remember how I got here.


    All
    I remember is a note that says "Lights harm them". What does that mean?


    The
    house shifts when I look away. The halls feel longer each time I return to them.


    Something
    inside wants me to keep moving. I need to keep moving.


    I need to make it
    out.

'
  typeSpeed: 0.05
  journalDelayBeforeLoad: 1.5
  typewriterAudio: {fileID: 1402159009}
  skipHintText: {fileID: 1485067413}
  creditsPanel: {fileID: 713249266}
